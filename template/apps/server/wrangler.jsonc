{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "__APP_NAME__",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // The web app is served from Workers static assets; only /api/* reaches the worker.
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__APP_NAME__",
      // Replace with the id printed by `wrangler d1 create __APP_NAME__` before the first deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "APP_VERSION": "0.0.0", "ENVIRONMENT": "production" }
}
