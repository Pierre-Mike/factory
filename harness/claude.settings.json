{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bun run check)",
      "Bash(bun run smoke)",
      "Bash(bun run e2e)",
      "Bash(bun run dev)",
      "Bash(bun run lint)",
      "Bash(bun run deploy:dry)",
      "Bash(bun run ci:dry)",
      "Bash(bunx axioms check)",
      "Bash(bunx axioms doctor)",
      "Bash(bunx axioms sync)",
      "Bash(bunx axioms notes)",
      "Bash(bunx axioms notes --seal)",
      "Bash(bunx axioms secret-scan --staged)",
      "Bash(bunx axioms commit-msg:*)",
      "Bash(bunx axioms biome check --write --no-errors-on-unmatched:*)",
      "Bash(bunx axioms ci-dry-run)",
      "Bash(bunx axioms e2e)"
    ]
  }
}
